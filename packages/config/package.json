{
  "name": "@bec/config",
  "version": "0.0.0",
  "private": true,
  "description": "Per-environment configuration via Zod (ADR-038).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "tsc",
    "lint": "echo '(noop)'",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@bec/config-eslint": "workspace:*",
    "@bec/config-tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
