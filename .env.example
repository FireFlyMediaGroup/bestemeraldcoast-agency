# ──────────────────────────────────────────────────────────────────────
# bestemeraldcoast-agency — .env.example
#
# Copy to .env (gitignored) and fill in values.
# Real values live in 1Password vault `BEC-Production` (ADR-007).
#
# Schema lives in packages/config/src/env.ts. Boot fails loudly when a
# required var is missing in production (per ADR-038).
# ──────────────────────────────────────────────────────────────────────

# ─── Runtime ──────────────────────────────────────────────────────────
# `development` | `test` | `production`. Vercel sets this automatically.
NODE_ENV=development

# Set by Vercel automatically: `production` | `preview` | `development`.
# Empty locally — falls back to NODE_ENV in resolveAppEnv().
VERCEL_ENV=

# ─── Database — Neon Postgres (ADR-002) ───────────────────────────────
# Pooled connection. Required in every env.
DATABASE_URL=postgres://user:password@localhost:5432/bec

# Direct (non-pooled) connection. Used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=

# ─── ADR-038 safety rails ─────────────────────────────────────────────
# Set to `true` to allow connections to the production database from a
# non-production env. Required for any local prod migration / debug.
PROD_DB_ALLOWED=false

# Set to `true` to enable real email sending outside production.
# Otherwise email goes to Mailhog (local) or Resend test mode.
EMAIL_REAL_SEND_ENABLED=false

# ─── Internal API auth (ADR-003) ──────────────────────────────────────
# Shared secret agents send as `Authorization: Bearer ${AGENT_API_KEY}`.
# Required in production.
AGENT_API_KEY=

# Base URL the local Scout/Diagnoser agents POST every write to (the
# deployed ops-console agent API). Agent-runtime only — NOT read by any
# deployed code, so do NOT set this on Vercel. Agents always target the
# live console even when run locally (ADR-003: Postgres is the single
# source of truth; the agent API is the only write path).
OPS_CONSOLE_URL=https://ops.bestemeraldcoast.com

# ─── Operator auth — NextAuth (Phase 1) ───────────────────────────────
NEXTAUTH_URL=http://localhost:3001
# 32+ characters. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=
# Single allow-listed operator address. ops-console magic-link sign-in
# rejects every other email. Required in production.
OPERATOR_EMAIL=

# ─── Anthropic (ADR-004, ADR-018) ─────────────────────────────────────
# Agent runtime. Must start with `sk-ant-`. Daily/monthly caps live in
# the agent_budgets table.
ANTHROPIC_API_KEY=

# ─── Email — Resend + AWS SES (ADR-013) ───────────────────────────────
# Outreach + transactional. Must start with `re_`.
RESEND_API_KEY=

# Outreach send identity (Commit 2.9). ADR-013 amended 2026-05-19: v1 sends
# from the already-verified `ops.bestemeraldcoast.com` Resend domain (the
# dedicated `mail.` domain warm-up is deferred to ADR-013's Phase-6
# reputation trigger). All optional — the send route has safe defaults.
#  - OUTREACH_FROM_EMAIL: From address (default noreply@ops.bestemeraldcoast.com).
#    From-name stays dynamic per site (sites.sending_from_name).
#  - OUTREACH_REPLY_TO: monitored inbox for replies. When set, the email's
#    Reply-To points here AND the footer invites "reply 'unsubscribe'".
#    When unset, the inbound-reply loop (ADR-024) is parked AND the
#    footer falls back to a mailto: against OUTREACH_UNSUBSCRIBE_EMAIL.
#  - OUTREACH_UNSUBSCRIBE_EMAIL: explicit opt-out inbox used by the footer
#    when OUTREACH_REPLY_TO is unset. The send route refuses to send
#    (412 opt_out_misconfigured) if neither this nor OUTREACH_REPLY_TO
#    nor OPERATOR_EMAIL is set — CAN-SPAM requires a working opt-out.
#  - OUTREACH_POSTAL_ADDRESS: physical mailing address in the email footer
#    — CAN-SPAM requirement (ADR-014/031). Set a real address before sending.
OUTREACH_FROM_EMAIL=noreply@ops.bestemeraldcoast.com
OUTREACH_REPLY_TO=
OUTREACH_UNSUBSCRIBE_EMAIL=
OUTREACH_POSTAL_ADDRESS=

# Bulk newsletter sending. SES production access requires a sandbox-exit
# request (start early — 24-48h AWS turnaround).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── Object storage (ADR-005) ─────────────────────────────────────────
# Vercel Blob — hot path (hero images, OG cards, newsletter inline).
BLOB_READ_WRITE_TOKEN=

# Backblaze B2 — cold path (mockup archives, video, backups).
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=

# ─── Observability — Sentry + Axiom (ADR-012) ─────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
AXIOM_TOKEN=
AXIOM_DATASET=

# ─── Analytics — PostHog (ADR-011) ────────────────────────────────────
# Server-side capture (admin / agent events).
POSTHOG_API_KEY=

# Public — exposed to the browser.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Rate limiting + bot defense (ADR-017) ────────────────────────────
# Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Vercel cron auth (Phase 6) ───────────────────────────────────────
# 16+ characters. Cron handlers verify `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=

# ─── Scout — Google Maps Places (Phase 1) ─────────────────────────────
GOOGLE_MAPS_API_KEY=
