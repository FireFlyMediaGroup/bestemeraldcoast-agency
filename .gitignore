# ──────────────────────────────────────────────────────────────────────
# bestemeraldcoast-agency .gitignore
# Defense-in-depth for a *public* repo while CodeRabbit's OSS free tier
# is active. Tighten further if anything sensitive is added to the tree.
# ──────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
.turbo/
dist/
build/
out/
storybook-static/

# Test coverage
coverage/
*.lcov

# ──────────────────────────────────────────────────────────────────────
# Environment files — broad catch, then whitelist the documented examples
# ──────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.example.*

# ──────────────────────────────────────────────────────────────────────
# Secrets, certificates, private keys — never commit
# ──────────────────────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
secrets/
.secrets/
credentials/
.credentials/
private/

# SSH keys (in case someone copies one into the tree)
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
*.ppk

# ──────────────────────────────────────────────────────────────────────
# Cloud provider local credential caches
# ──────────────────────────────────────────────────────────────────────
.aws/
.gcp/
gcloud/
.azure/

# Loose credential / service-account files that sometimes land in the tree
aws-credentials*
.aws-credentials*
gcp-credentials*
service-account*.json
credentials.json
client_secret*.json

# 1Password CLI session / vaults
.op/
*.opvault
.config/op/

# ──────────────────────────────────────────────────────────────────────
# Local databases and dumps (could contain prod data)
# ──────────────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.dump
*.sql.gz
*.sql.zip
*.bak

# ──────────────────────────────────────────────────────────────────────
# Infrastructure-as-code state (often contains plaintext credentials)
# ──────────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
*.tfplan
.pulumi/
.serverless/

# Vercel CLI
.vercel
.netlify/

# ──────────────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ──────────────────────────────────────────────────────────────────────
# OS metadata
# ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ──────────────────────────────────────────────────────────────────────
# Editor / IDE
# ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ──────────────────────────────────────────────────────────────────────
# Claude Code — operator-local settings only (shared settings.json is committed)
# ──────────────────────────────────────────────────────────────────────
.claude/settings.local.json

# ──────────────────────────────────────────────────────────────────────
# Agent runtime scratch (ADR-003: filesystem is for prompt artifacts + scratch only)
# ──────────────────────────────────────────────────────────────────────
agency/state/
agency/.env
agency/scratch/
agency/runs/

# ──────────────────────────────────────────────────────────────────────
# TypeScript / Next.js build artifacts
# ──────────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ──────────────────────────────────────────────────────────────────────
# Miscellaneous local scratch (anything in tmp/ is operator-local)
# ──────────────────────────────────────────────────────────────────────
tmp/
.tmp/
*.tmp
*.orig
